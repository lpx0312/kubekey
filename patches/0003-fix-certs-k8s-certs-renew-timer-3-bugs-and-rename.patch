From ae7df0794aaf7a691d416812937cdeb32d89a977 Mon Sep 17 00:00:00 2001
From: lpx <lpx_0312@163.com>
Date: Wed, 8 Jul 2026 22:47:02 +0800
Subject: [PATCH] fix(certs): k8s-certs-renew timer always failed - 3 bugs +
 rename

The automatic certificate renewal timer (deployed as k8s-certs-renew.timer
via systemd, runs weekly) has never worked since cluster creation, so
kubeadm control-plane certs never get auto-renewed. Three compounding
bugs, plus a rename for consistency:

1. Go template trim collapses the script into one line.
   The {{- if/else/end -}} block uses greedy trim, so after rendering
   the shebang, the kubeadmCerts assignment and the function opening
   brace are joined into a single line, corrupting bash syntax.
   Fix: remove the <v1.20.0 branch (dead code, kubekey v4 supports
   >= v1.23) and hardcode 'kubeadm certs'.

2. Date-parsing regex never matches.
   getCertValidDays() uses grep with PCRE escapes (\s \w) under BRE,
   which never match, so the timer renew-spams (or silently skips).
   Fix: parse the "RESIDUAL TIME" column ("NNNd") from kubeadm output
   with grep -oE; fall back to 9999 (skip) on parse failure. Add
   set -euo pipefail.

3. Rename renew_script.sh -> k8s-certs-renew.sh for consistency,
   so the template, the deployed file, and the systemd ExecStart all
   share one name. (The original service referenced k8s-certs-renew.sh
   which didn't exist; patch now makes the name match reality.)
---
 .../roles/kubernetes/certs/tasks/main.yaml    |  4 +--
 .../{renew_script.sh => k8s-certs-renew.sh}   | 27 +++++++++++++------
 2 files changed, 21 insertions(+), 10 deletions(-)
 rename builtin/core/roles/kubernetes/certs/templates/{renew_script.sh => k8s-certs-renew.sh} (56%)

diff --git a/builtin/core/roles/kubernetes/certs/tasks/main.yaml b/builtin/core/roles/kubernetes/certs/tasks/main.yaml
index 70127d86..c6f98f73 100644
--- a/builtin/core/roles/kubernetes/certs/tasks/main.yaml
+++ b/builtin/core/roles/kubernetes/certs/tasks/main.yaml
@@ -1,8 +1,8 @@
 ---
 - name: Certs | Generate Kubernetes certificate renewal script
   template:
-    src: renew_script.sh
-    dest: /usr/local/bin/kube-scripts/renew_script.sh
+    src: k8s-certs-renew.sh
+    dest: /usr/local/bin/kube-scripts/k8s-certs-renew.sh
     mode: 0755
 
 - name: Certs | Deploy certificate renewal systemd service
diff --git a/builtin/core/roles/kubernetes/certs/templates/renew_script.sh b/builtin/core/roles/kubernetes/certs/templates/k8s-certs-renew.sh
similarity index 56%
rename from builtin/core/roles/kubernetes/certs/templates/renew_script.sh
rename to builtin/core/roles/kubernetes/certs/templates/k8s-certs-renew.sh
index 4dd9c02b..1453eba6 100644
--- a/builtin/core/roles/kubernetes/certs/templates/renew_script.sh
+++ b/builtin/core/roles/kubernetes/certs/templates/k8s-certs-renew.sh
@@ -1,26 +1,37 @@
 #!/bin/bash
-{{- if .kubernetes.kube_version | semverCompare "<v1.20.0" -}}
-kubeadmCerts='/usr/local/bin/kubeadm alpha certs'
-{{- else -}}
+set -euo pipefail
+
+# kubekey v4 supports kubernetes >= v1.23, so kubeadm certs subcommand is always available.
 kubeadmCerts='/usr/local/bin/kubeadm certs'
-{{- end -}}
 
+# Return the smallest residual days among all kubeadm-managed certificates.
+# Uses the "RESIDUAL TIME" column from "kubeadm certs check-expiration" (e.g. "364d").
+# Falls back to 9999 (skip renewal) when parsing fails, so the timer never renew-spams.
 getCertValidDays() {
-  local earliestExpireDate; earliestExpireDate=$(${kubeadmCerts} check-expiration | grep -o "[A-Za-z]\{3,4\}\s\w\w,\s[0-9]\{4,\}\s\w*:\w*\s\w*\s*" | xargs -I {} date -d {} +%s | sort | head -n 1)
-  local today; today="$(date +%s)"
-  echo -n $(( ($earliestExpireDate - $today) / (24 * 60 * 60) ))
+  local days
+  days=$(${kubeadmCerts} check-expiration 2>/dev/null | grep -oE '[0-9]+d' | grep -oE '[0-9]+' | sort -n | head -1)
+  if [ -z "${days}" ]; then
+    days=9999
+  fi
+  echo -n "${days}"
 }
+
 echo "## Expiration before renewal ##"
 ${kubeadmCerts} check-expiration
-if [ $(getCertValidDays) -lt 30 ]; then
+
+if [ "$(getCertValidDays)" -lt 30 ]; then
   echo "## Renewing certificates managed by kubeadm ##"
   ${kubeadmCerts} renew all
+
   echo "## Restarting control plane pods managed by kubeadm ##"
   $(which crictl | grep crictl) pods --namespace kube-system --name 'kube-scheduler-*|kube-controller-manager-*|kube-apiserver-*|etcd-*' -q | /usr/bin/xargs $(which crictl | grep crictl) rmp -f
+
   echo "## Updating /root/.kube/config ##"
   cp /etc/kubernetes/admin.conf /root/.kube/config
 fi
+
 echo "## Waiting for apiserver to be up again ##"
 until printf "" 2>>/dev/null >>/dev/tcp/127.0.0.1/6443; do sleep 1; done
+
 echo "## Expiration after renewal ##"
 ${kubeadmCerts} check-expiration
-- 
2.43.0.windows.1

