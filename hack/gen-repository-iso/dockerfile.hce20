FROM registry.cn-hangzhou.aliyuncs.com/lpx03/hce:2.0 as hce20

ARG TARGETARCH
ARG DIR=hce-2.0-${TARGETARCH}-rpms
ARG PKGS=".common[],.rpms[]"
ARG BUILD_TOOLS="createrepo_c genisoimage"

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# HCE 2.0 官方源（基于 openEuler 22.03 LTS）。两架构 baseurl 不同，按 TARGETARCH 选择。
# 验证：x86_64/aarch64 的 repodata/repomd.xml 均可访问（HTTP 200）。
RUN if [ "$TARGETARCH" = "amd64" ]; then \
       BASEURL="https://repo.huaweicloud.com/hce/2.0/os/x86_64/"; \
    else \
       BASEURL="https://repo.huaweicloud.com/hce/2.0/os/aarch64/"; \
    fi \
    && echo "[hce-base]" > /etc/yum.repos.d/hce.repo \
    && echo "name=HCE 2.0 Base" >> /etc/yum.repos.d/hce.repo \
    && echo "baseurl=$BASEURL" >> /etc/yum.repos.d/hce.repo \
    && echo "enabled=1" >> /etc/yum.repos.d/hce.repo \
    && echo "gpgcheck=0" >> /etc/yum.repos.d/hce.repo \
    && rm -f /etc/yum.repos.d/*.repo.* 2>/dev/null || true \
    && yum clean all \
    && yum makecache --disablerepo="*" --enablerepo="hce-base"

RUN yum install -y --disablerepo="*" --enablerepo="hce-base" $BUILD_TOOLS \
    && yum clean all

WORKDIR /package

COPY packages.yaml .
COPY --from=mikefarah/yq:4.11.1 /usr/bin/yq /usr/bin/yq

# 沿用 kylin 的逐包下载 + 容错模式：
# HCE 源里 conntrack（命令由 conntrack-tools 提供）、nss-sysinit、nss-tools 不存在，
# 用 || echo "not found" 跳过，不影响其余包与 ISO 生成。
RUN mkdir -p ${DIR} \
    && yq eval "${PKGS}" packages.yaml | while read pkg; do \
         if [ -n "$pkg" ]; then \
             echo "Downloading $pkg..."; \
             yum install -y --downloadonly --downloaddir=${DIR} --disablerepo="*" --enablerepo="hce-base" $pkg || echo "not found: $pkg"; \
         fi; \
    done

RUN createrepo_c ${DIR} \
    && genisoimage -r -o ${DIR}.iso ${DIR}

FROM scratch
COPY --from=hce20 /package/*.iso /
